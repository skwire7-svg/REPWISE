# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Next.js reads env files only at startup — restart the dev server after any
# change here.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable ("anon") key. Public by design — it ships in the browser
# bundle. Row Level Security is what actually protects the data behind it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only, and optional. Bypasses Row Level Security entirely — must never
# be exposed to the browser and must never be prefixed with NEXT_PUBLIC_.
# The app does not need it: the schema and seed are applied from the SQL Editor,
# which already runs with elevated privileges. Set it only if you add a
# maintenance script that needs to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (aistudio.google.com/apikey) ---
# Server-only. Powers all three AI features: the workout generator, the diet
# generator and the AI coach. Without it those three show a "not configured"
# message; everything else works.
#
# A free-tier key is enough. The free tier is rate limited per minute and per
# day, so generating several plans back to back can trip a quota error — the
# app surfaces that as a "wait a minute and try again" message rather than a
# crash.
GEMINI_API_KEY=
